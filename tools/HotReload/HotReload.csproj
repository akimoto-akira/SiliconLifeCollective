<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HotReload</AssemblyName>
    <RootNamespace>SiliconLife.Tools.HotReload</RootNamespace>
    <Company>Hoshino Kennji</Company>
    <!--
      独立输出目录 — 故意与 SiliconLife.Fast 的 bin 完全隔离，
      这样 HotReload.exe 在覆盖部署文件时永远不会被自己覆盖。
    -->
  </PropertyGroup>

</Project>
