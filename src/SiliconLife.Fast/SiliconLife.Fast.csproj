<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SiliconLife.Core\SiliconLife.Core.csproj" />
    <ProjectReference Include="..\SiliconLife.Common\SiliconLife.Common.csproj" />
    <ProjectReference Include="..\SiliconLife.App\SiliconLife.App.csproj" />
    <ProjectReference Include="..\SiliconLife.Speedy\SiliconLife.Speedy.csproj" />
    <ProjectReference Include="..\SiliconLife.Speedy.Manager\SiliconLife.Speedy.Manager.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>Hoshino Kennji</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="System.Reactive" Version="6.0.0" />
  </ItemGroup>

  <!-- Copy tray icon to output directory -->
  <ItemGroup>
    <None Update="slc.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="SiliconLife.Fast.csproj.targets" Condition="Exists('SiliconLife.Fast.csproj.targets')" />
</Project>
