<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiliconLife.Core\SiliconLife.Core.csproj" />
    <ProjectReference Include="..\SiliconLife.Common\SiliconLife.Common.csproj" />
    <ProjectReference Include="..\SiliconLife.Speedy\SiliconLife.Speedy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="PHPText.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>PHPText.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="PHPText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PHPText.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
