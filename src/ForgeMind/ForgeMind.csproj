<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0-windows：仅为获取编译期 Microsoft.Win32.Registry 引用（UE 引擎注册表检测）。
         运行时 Microsoft.Win32.Registry.dll 内置于 Windows 版 Microsoft.NETCore.App，
         插件仍由 net9.0 宿主进程加载，不产生任何额外依赖 DLL -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ForgeMind</AssemblyName>
    <RootNamespace>ForgeMind</RootNamespace>
    <Company>Hoshino Kennji</Company>
    <Version>1.0.0.0</Version>
    <Authors>HoshinoKennji</Authors>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- 编译结果直接输出到 PluginDemo\ForgeMind（插件发现目录），
         PluginLoader 会按子目录名 ForgeMind 匹配 ForgeMind.dll 加载。
         不随 Debug/Release 与 TFM 变化 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\PluginDemo\ForgeMind\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：不把 SiliconLife.Core.dll 复制进插件目录，
         宿主进程已加载 Core，PluginLoadContext 会直接复用宿主版本 -->
    <ProjectReference Include="..\SiliconLife.Core\SiliconLife.Core.csproj" Private="false" />
    <!-- Private 默认 true：SiliconLife.Speedy.dll（及其 MessagePack 依赖，
         已在宿主 TrustedAssemblies 白名单）随插件分发，
         供只读 spk 知识库后端使用 -->
    <ProjectReference Include="..\SiliconLife.Speedy\SiliconLife.Speedy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 开发阶段知识库：教材源文件位于仓库 ForgeMind\Knowledge，
         构建时复制到插件目录的 Knowledge\ 下供 FolderKnowledgeSource 读取；
         发布阶段改用同目录的 ue-knowledge.spk 只读包（自动优先） -->
    <None Include="..\..\ForgeMind\Knowledge\**" Link="Knowledge\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Knowledge\5.6\**" />
    <None Remove="Knowledge\universal\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Knowledge\5.6\**" />
    <Compile Remove="Knowledge\universal\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Knowledge\5.6\**" />
    <EmbeddedResource Remove="Knowledge\universal\**" />
  </ItemGroup>

</Project>
