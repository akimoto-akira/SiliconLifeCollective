<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SiliconLife.Speedy.Manager.MainWindow"
        Title="Speedy Pack Manager"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FBFBFB">

    <DockPanel>
        <!-- Ribbon Panel -->
        <Border DockPanel.Dock="Top" Background="White" Padding="12,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <StackPanel Margin="0,0,8,0">
                        <Button x:Name="BtnOpen" Content="📂 Open" Width="120" Height="48"
                                FontSize="13" Cursor="Hand"
                                Background="Transparent"
                                CornerRadius="4" />
                        <TextBlock Text="File" FontSize="11" Foreground="#606060"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>

                    <Rectangle Width="1" Fill="#DCDCDC" Margin="4,4" />

                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
                        <StackPanel Margin="0,0,4,0">
                            <Button x:Name="BtnRefresh" Content="🔄 Refresh" Width="110" Height="48"
                                    FontSize="13" Cursor="Hand"
                                    Background="Transparent" IsEnabled="False"
                                    CornerRadius="4" />
                        </StackPanel>
                        <StackPanel>
                            <Button x:Name="BtnCompact" Content="🗜️ Compact" Width="120" Height="48"
                                    FontSize="13" Cursor="Hand"
                                    Background="Transparent" IsEnabled="False"
                                    CornerRadius="4" />
                            <TextBlock Text="View" FontSize="11" Foreground="#606060"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Breadcrumb Panel -->
        <Border DockPanel.Dock="Top" Background="White" Padding="8,4" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <ItemsControl x:Name="BreadcrumbPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="8,4" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="ItemCountLabel" Text="0 items" FontSize="12"
                           Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid ColumnDefinitions="235,Auto,*">
            <!-- Tree View Panel -->
            <Border Grid.Column="0" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <TreeView x:Name="DirectoryTree"
                          Padding="4"
                          Background="Transparent"
                          BorderThickness="0" />
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="#E6E6E6" />

            <!-- Right Panel: List + Preview -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto,200">
                <!-- File List -->
                <DataGrid x:Name="FileList"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="0"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                          DoubleTapped="FileList_DoubleTapped"
                          SelectionChanged="FileList_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="320" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="4" Background="#E6E6E6" />

                <!-- Preview Panel -->
                <Border Grid.Row="2" Background="#FAFAFA" Padding="8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <TextBox x:Name="PreviewTextBox"
                             Text="Select a file to preview content"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas,Courier New"
                             FontSize="13"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
