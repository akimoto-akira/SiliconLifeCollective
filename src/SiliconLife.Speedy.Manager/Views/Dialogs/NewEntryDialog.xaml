<Window x:Class="SiliconLife.Speedy.Manager.Views.Dialogs.NewEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="新建条目"
        Width="420" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Virtual Path -->
        <Label Grid.Row="0" Content="虚拟路径:" Padding="0,0,0,2"/>
        <TextBox Grid.Row="1"
                 Text="{Binding VirtualPath, UpdateSourceTrigger=PropertyChanged}"
                 Padding="4,3"
                 Margin="0,0,0,4"/>

        <!-- Validation Error -->
        <TextBlock Grid.Row="2"
                   Text="{Binding PathValidationError}"
                   Foreground="Red"
                   FontSize="11"
                   Margin="0,0,0,8"
                   Visibility="{Binding PathValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>

        <!-- Content Type -->
        <Label Grid.Row="3" Content="内容类型:" Padding="0,0,0,2"/>
        <ComboBox Grid.Row="4"
                  ItemsSource="{Binding ContentTypes}"
                  SelectedItem="{Binding ContentType}"
                  Margin="0,0,0,0"
                  VerticalAlignment="Top"
                  Padding="4,3"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="确认"
                    Command="{Binding ConfirmCommand}"
                    Width="80"
                    Margin="0,0,8,0"
                    IsDefault="True"/>
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
