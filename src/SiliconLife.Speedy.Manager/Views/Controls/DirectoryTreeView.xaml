<UserControl x:Class="SiliconLife.Speedy.Manager.Views.Controls.DirectoryTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SiliconLife.Speedy.Manager.Models"
             mc:Ignorable="d"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- ─── TreeViewItem container style ─── -->
        <Style x:Key="TreeViewItemContainerStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
        </Style>

        <!-- ─── Node header HierarchicalDataTemplate ─── -->
        <HierarchicalDataTemplate x:Key="PackEntryNodeTemplate"
                                  DataType="{x:Type models:PackEntryNode}"
                                  ItemsSource="{Binding Children}">
            <Border x:Name="NodeBorder"
                    Padding="2,1"
                    CornerRadius="2"
                    Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <!-- Icon: emoji based on IsDirectory / ContentType -->
                    <TextBlock x:Name="NodeIcon"
                               Text="📄"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <!-- Display name -->
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <HierarchicalDataTemplate.Triggers>
                <!-- Directory → folder icon -->
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="NodeIcon" Property="Text" Value="📁"/>
                </DataTrigger>

                <!-- Highlight background when search matches -->
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="NodeBorder" Property="Background" Value="#FFFF99"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── Row 0: Search Box ─── -->
        <Border Grid.Row="0"
                Padding="4"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜索条目路径"
                     Padding="4,2">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍 搜索..." Margin="4,2"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <!-- ─── Row 1: No-results hint (visible only when ShowNoResultsHint = true) ─── -->
        <TextBlock Grid.Row="1"
                   Text="未找到匹配条目"
                   HorizontalAlignment="Center"
                   Margin="4,4"
                   Foreground="Gray"
                   FontStyle="Italic"
                   Visibility="{Binding ShowNoResultsHint,
                       Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ─── Row 2: TreeView area ─── -->
        <Grid Grid.Row="2">
            <!-- Empty-state hint: shown when no file is open (RootNodes empty, no search active) -->
            <TextBlock x:Name="EmptyStateHint"
                       Text="请打开 .spk 文件"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#AAAAAA"
                       FontStyle="Italic"
                       Visibility="Collapsed"/>

            <!-- Directory TreeView -->
            <TreeView x:Name="DirectoryTree"
                      ItemsSource="{Binding RootNodes}"
                      ItemTemplate="{StaticResource PackEntryNodeTemplate}"
                      ItemContainerStyle="{StaticResource TreeViewItemContainerStyle}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectedItemChanged="DirectoryTree_SelectedItemChanged">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建条目..."
                                  Command="{Binding PlacementTarget.DataContext.NewEntryCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="删除"
                                  Command="{Binding PlacementTarget.DataContext.DeleteEntryCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SelectedNode,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="导入文件..."
                                  Command="{Binding PlacementTarget.DataContext.ImportFilesCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="导出条目..."
                                  Command="{Binding PlacementTarget.DataContext.ExportEntryCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SelectedNode,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="导出目录..."
                                  Command="{Binding PlacementTarget.DataContext.ExportDirectoryCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SelectedNode,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
