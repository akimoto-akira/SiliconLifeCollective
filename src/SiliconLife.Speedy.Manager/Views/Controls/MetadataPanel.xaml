<UserControl x:Class="SiliconLife.Speedy.Manager.Views.Controls.MetadataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SiliconLife.Speedy.Manager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MetadataPanelViewModel}"
             Background="#F5F5F5">

    <Grid Margin="8,6,8,6">

        <!-- No-selection hint: shown when HasSelection = false -->
        <TextBlock Text="请选择条目或目录"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#AAAAAA"
                   FontStyle="Italic"
                   FontSize="12"
                   Visibility="{Binding HasSelection,
                       Converter={StaticResource BoolToVisibilityConverter},
                       ConverterParameter=Invert}"/>

        <!-- Metadata content: shown when HasSelection = true -->
        <Grid Visibility="{Binding HasSelection,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Row 0: Virtual Path (always shown) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Content Type (entry only) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Size (entry only) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Created At (entry only) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Updated At (entry only) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 5: Sub-entries (directory only) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 6: Sub-directories (directory only) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Row 0: Virtual Path (always shown) ─── -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="虚拟路径："
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,4,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding VirtualPath}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding VirtualPath}"
                       Margin="0,2,0,2"/>

            <!-- ─── Row 1: Content Type (entry only) ─── -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="内容类型："
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,4,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding ContentType}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>

            <!-- ─── Row 2: Size (entry only) ─── -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="大小："
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,4,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding Length}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>

            <!-- ─── Row 3: Created At (entry only) ─── -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="创建时间："
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,4,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>

            <!-- ─── Row 4: Updated At (entry only) ─── -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="修改时间："
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,4,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>
            <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter},
                           ConverterParameter=Invert}"/>

            <!-- ─── Row 5: Sub-entries (directory only) ─── -->
            <TextBlock Grid.Row="5" Grid.Column="0"
                       Text="子条目："
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,4,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Grid.Row="5" Grid.Column="1"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter}}">
                <Run Text="{Binding EntryCount, Mode=OneWay}"/>
                <Run Text=" 个条目"/>
            </TextBlock>

            <!-- ─── Row 6: Sub-directories (directory only) ─── -->
            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="子目录："
                       FontSize="11"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,4,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Grid.Row="6" Grid.Column="1"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       Visibility="{Binding IsDirectory,
                           Converter={StaticResource BoolToVisibilityConverter}}">
                <Run Text="{Binding DirCount, Mode=OneWay}"/>
                <Run Text=" 个子目录"/>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
